{
  "name": "jixomd",
  "version": "0.1.1",
  "description": "A pure Markdown expansion engine — resolve [target](@FILE) directives into real content.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jixoai/jixomd"
  },
  "homepage": "https://github.com/jixoai/jixomd#readme",
  "bugs": {
    "url": "https://github.com/jixoai/jixomd/issues"
  },
  "keywords": [
    "markdown",
    "prompt-engineering",
    "ai",
    "llm",
    "codegen",
    "documentation",
    "preprocessor"
  ],
  "engines": {
    "node": ">=14"
  },
  "bin": {
    "jixomd": "bin/jixomd"
  },
  "main": "index.js",
  "files": [
    "bin/",
    "index.js",
    "platform.js",
    "packed.js",
    "README.md"
  ],
  "optionalDependencies": {
    "@jixo/md-darwin-arm64": "workspace:*",
    "@jixo/md-darwin-x64": "workspace:*",
    "@jixo/md-linux-arm64": "workspace:*",
    "@jixo/md-linux-x64": "workspace:*",
    "@jixo/md-win-arm64": "workspace:*",
    "@jixo/md-win-x64": "workspace:*"
  }
}
