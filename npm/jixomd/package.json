{
  "name": "jixomd",
  "version": "0.1.7",
  "description": "A pure Markdown expansion engine — resolve [target](@FILE) directives into real content.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jixoai/jixomd"
  },
  "homepage": "https://github.com/jixoai/jixomd#readme",
  "bugs": {
    "url": "https://github.com/jixoai/jixomd/issues"
  },
  "keywords": [
    "markdown",
    "prompt-engineering",
    "ai",
    "llm",
    "codegen",
    "documentation",
    "preprocessor"
  ],
  "engines": {
    "node": ">=16"
  },
  "type": "commonjs",
  "bin": {
    "jixomd": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/bin.ts --format cjs --clean --out-dir dist && tsc --emitDeclarationOnly --declaration --outDir dist --rootDir src --moduleResolution NodeNext --module NodeNext --target ES2020 --strict --skipLibCheck --types node src/index.ts src/bin.ts",
    "prepublishOnly": "npm run build"
  },
  "optionalDependencies": {
    "@jixo/md-darwin-arm64": "workspace:*",
    "@jixo/md-darwin-x64": "workspace:*",
    "@jixo/md-linux-arm64": "workspace:*",
    "@jixo/md-linux-x64": "workspace:*",
    "@jixo/md-win-arm64": "workspace:*",
    "@jixo/md-win-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.7.0"
  }
}
