#!/usr/bin/env node
'use strict';
// CLI entry shim. Resolves the native binary via the same logic as index.js
// (installed optional dependency / local workspace / JIXOMD_BINARY_PATH) and
// forwards all args.
const { spawnSync } = require('child_process');
const { binaryPath } = require('../index.js');
const bin = binaryPath();
const result = spawnSync(bin, process.argv.slice(2), { stdio: 'inherit' });
process.exit(result.status || 0);
